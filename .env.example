# Public subpath on the Hub domain (default /tesway-ebike). Must match the Hub rewrite.
NEXT_PUBLIC_BASE_PATH=/tesway-ebike

# Optional. Leave empty until real IDs exist. No tracking script loads when empty.
# Review consent requirements before filling these in.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Rating badge in the hero (default shown). Set to false to hide it.
NEXT_PUBLIC_SHOW_REVIEW_BADGE=true

# Brevo hosted-form action URL (a default is built in; override only if you regenerate the form).
NEXT_PUBLIC_BREVO_FORM_ACTION=
